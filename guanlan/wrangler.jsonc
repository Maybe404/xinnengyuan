{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guanlan",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "guanlan.maybe404.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
